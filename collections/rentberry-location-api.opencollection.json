{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Location API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Location",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get countries list",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/country",
            "params": [
              {
                "name": "withApartments",
                "value": "",
                "type": "query",
                "description": "Filter to only countries with available listings"
              },
              {
                "name": "transactionType",
                "value": "",
                "type": "query",
                "description": "Type of transaction (only used when withApartments=true)"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns list of countries, optionally filtered to only include countries with available listings."
        },
        {
          "info": {
            "name": "Get country settings by address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/country-settings",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Available since API version 1. Geocodes an address and returns country-specific settings for that location."
        },
        {
          "info": {
            "name": "Geocode formatted address",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/place/geocode",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Converts a formatted address string into geographic location data"
        }
      ]
    }
  ],
  "bundled": true
}