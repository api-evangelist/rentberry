            "params": [
              {
                "name": "reference",
                "value": "",
                "type": "query",
                "description": "JWT token for accessing subscriptions without authentication (from email links)"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Available since API version 1. Updates subscription preferences for specific notification groups. Can be accessed via JWT token from email unsubscribe links."
        },
        {
          "info": {
            "name": "Toggle subscription type (SMS/Email)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/subscription/type-status/:groupType/toggle",
