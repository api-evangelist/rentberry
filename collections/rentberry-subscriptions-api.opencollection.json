                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Toggles all notifications of specified type (SMS or Email) on/off. Returns new subscription status."
        },
        {
          "info": {
            "name": "Get subscription type statuses",
