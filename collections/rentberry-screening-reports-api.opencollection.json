{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Screening Reports API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Screening Reports",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get criminal background report (HTML)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/screening/criminal-report/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Screening request ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns HTML criminal background report for completed screening."
        },
        {
          "info": {
            "name": "Get credit score report (HTML)",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/screening/credit-score/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Screening request ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns HTML credit score report for completed screening."
        },
        {
          "info": {
            "name": "Get screening reports preview",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/screening/reports-preview/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Screening request ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns summary preview of both credit and criminal reports for completed screening."
        }
      ]
    }
  ],
  "bundled": true
}