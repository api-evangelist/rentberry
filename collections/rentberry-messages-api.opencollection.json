{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Messages API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Messages",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get list of conversations for user.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/messages/:userType",
            "params": [
              {
                "name": "userType",
                "value": "",
                "type": "path",
                "description": "User type filter"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Items per page"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns paginated list of conversations for tenant or homeowner."
        },
        {
          "info": {
            "name": "Get or create conversation for apartment listing.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v:version/messages/apartment/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Apartment listing ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Available since API version 1. Gets existing or creates new conversation for apartment listing."
        },
        {
          "info": {
            "name": "Get or create conversation for rental.",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "{{baseUrl}}/v:version/messages/rental/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Rental ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Gets existing or creates new conversation for rental between tenant and homeowner."
        },
        {
          "info": {
            "name": "Get conversation details.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/messages/conversation/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Conversation ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns detailed information about a specific conversation."
        },
        {
          "info": {
            "name": "Get messages from conversation.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/messages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Conversation ID"
              },
              {
                "name": "before",
                "value": "",
                "type": "query",
                "description": "Get messages before this message ID"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of messages to return"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns paginated list of messages from a conversation."
        },
        {
          "info": {
            "name": "Send message to conversation.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/messages/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Conversation ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Available since API version 1. Sends a new message to the specified conversation."
        }
      ]
    }
  ],
  "bundled": true
}