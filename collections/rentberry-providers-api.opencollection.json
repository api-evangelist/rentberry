{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Providers API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Providers",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get provider configuration.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/provider/configuration/:provider",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "Provider name"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 3. Returns configuration for specified listing provider."
        },
        {
          "info": {
            "name": "Get provider logo redirect.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/provider/:provider/logo-:size",
            "params": [
              {
                "name": "provider",
                "value": "",
                "type": "path",
                "description": "Provider name"
              },
              {
                "name": "size",
                "value": "",
                "type": "path",
                "description": "Logo size"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 3. Redirects to provider logo URL."
        }
      ]
    }
  ],
  "bundled": true
}