        {
          "id": "118df332-26f5-46bf-943d-329290a25908",
          "name": "Create listing picture",
          "request": {
            "name": "Create listing picture",
            "description": {
              "content": "Available since API version 1. Uploads a new picture for a listing. If marked as cover, removes cover status from existing cover image.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "v{{version}}",
                "apartment",
                "pictures"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "multipart/form-data"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "imageFile",
                  "type": "file",
                  "description": "(Required) Image file to upload. Supported formats: PNG, JPEG, HEIC, HEIF. Max size: 20MB."
                },
                {
                  "key": "apartmentId",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Listing ID to associate the picture with"
                },
                {
                  "key": "cover",
                  "value": "false",
                  "type": "text",
                  "description": "Set this picture as cover image"
                },
                {
                  "key": "order",
                  "value": "<integer>",
                  "type": "text",
                  "description": "Display order of the picture"
                },
                {
                  "key": "type",
                  "value": "<string>",
                  "type": "text",
                  "description": "Type of picture (This can only be one of picture,floorPlan)"
                }
              ]
            }
          },
