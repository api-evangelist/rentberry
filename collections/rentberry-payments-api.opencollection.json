{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Payments API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Payments",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Create payment account for onboarding",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/payments/onboarding/account",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Creates a Stripe account for the user and returns an onboarding URL to complete setup."
        },
        {
          "info": {
            "name": "Finish payment onboarding",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/payments/onboarding/finish",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Completes the payment onboarding process for the authenticated user."
        },
        {
          "info": {
            "name": "Create Stripe payment for feature.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/user/feature/payment/stripe/feature/:type",
            "params": [
              {
                "name": "type",
                "value": "",
                "type": "path",
                "description": "Feature type"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Available since API version 1. Creates a Stripe payment intent for purchasing a feature."
        }
      ]
    }
  ],
  "bundled": true
}