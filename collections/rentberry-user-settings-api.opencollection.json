{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry User Settings API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "User Settings",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get user settings by keys.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/user/settings",
            "params": [
              {
                "name": "keys",
                "value": "",
                "type": "query",
                "description": "Comma-separated list of setting keys to retrieve"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns user settings values for specified keys."
        },
        {
          "info": {
            "name": "Set user settings.",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/user/settings",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Available since API version 1. Sets user settings with provided key-value pairs."
        }
      ]
    }
  ],
  "bundled": true
}