{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Resources API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Resources",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get states by country.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/resources/state/:country",
            "params": [
              {
                "name": "country",
                "value": "",
                "type": "path",
                "description": "Country code"
              },
              {
                "name": "withApartments",
                "value": "",
                "type": "query",
                "description": "Include only states with apartments"
              },
              {
                "name": "transactionType",
                "value": "",
                "type": "query",
                "description": "Transaction type filter"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns list of states for specified country."
        }
      ]
    }
  ],
  "bundled": true
}