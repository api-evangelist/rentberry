{
  "opencollection": "1.0.0",
  "info": {
    "name": "Rentberry Contract Templates API",
    "version": "4"
  },
  "items": [
    {
      "info": {
        "name": "Contract Templates",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List contract templates",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/contract/template",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number"
              },
              {
                "name": "limit",
                "value": "",
                "type": "query",
                "description": "Number of items per page"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Returns a paginated list of contract templates owned by the authenticated user."
        },
        {
          "info": {
            "name": "Create contract template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/contract/template",
            "params": [
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "contractTemplateFile",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Available since API version 1. Uploads and creates a new contract template."
        },
        {
          "info": {
            "name": "Update contract template",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "{{baseUrl}}/v:version/contract/template/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Contract template ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "multipart-form",
              "data": [
                {
                  "name": "name",
                  "type": "text",
                  "value": ""
                },
                {
                  "name": "contractTemplateFile",
                  "type": "text",
                  "value": ""
                }
              ]
            }
          },
          "docs": "Available since API version 1. Updates an existing contract template. Can update the name and/or template file."
        },
        {
          "info": {
            "name": "Delete contract template",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "{{baseUrl}}/v:version/contract/template/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Contract template ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Deletes an existing contract template."
        },
        {
          "info": {
            "name": "Download contract template file",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "{{baseUrl}}/v:version/contract/template/download/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "Contract template ID"
              },
              {
                "name": "version",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Available since API version 1. Downloads the contract template file."
        }
      ]
    }
  ],
  "bundled": true
}